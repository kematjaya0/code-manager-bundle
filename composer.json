        }
    ],
    "require": {
        "php": ">=8.1",
        "kematjaya/code-manager": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/uid": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "doctrine/orm": "^2.14|^3.0",
        "doctrine/doctrine-bundle": "^2.8"
