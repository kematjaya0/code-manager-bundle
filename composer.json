{
    "name": "kematjaya/code-manager-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "kematjaya/code-manager": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "doctrine/orm": "^2.14|^3.0",
        "doctrine/doctrine-bundle": "^2.13|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/var-dumper": "^7.4",
        "squizlabs/php_codesniffer": "^3.11|^4.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\CodeManagerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\CodeManagerBundle\\Tests\\": "tests/"
        }
    }
}
